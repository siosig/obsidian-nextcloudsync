{
  "name": "obsidian-nextcloudsync",
  "version": "1.0.5-beta.1",
  "description": "Bidirectional sync between Obsidian and Nextcloud",
  "main": "main.js",
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "lint": "eslint src",
    "secretlint": "secretlint \"**/*\"",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:b1": "jest --config jest.b1.config.js --runInBand",
    "test:b1:par": "jest --config jest.b1.config.js --maxWorkers=5",
    "test:b1:cluster": "bash scripts/b1-cluster.sh",
    "test:b2": "wdio run wdio.conf.mts",
    "test:b2:instance": "bash scripts/b2-instance.sh",
    "test:b3": "wdio run wdio.android.conf.mts",
    "test:b3:instance": "bash scripts/b3-android.sh",
    "test:b4": "bash scripts/b4-plain-webdav.sh"
  },
  "keywords": [
    "obsidian",
    "nextcloud",
    "sync",
    "webdav"
  ],
  "author": "Daisuke ITO",
  "license": "MIT",
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.2",
    "@secretlint/secretlint-rule-pattern": "^13.0.5",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.5",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.4.1",
    "@wdio/appium-service": "^9.31.6",
    "@wdio/cli": "^9.31.6",
    "@wdio/local-runner": "^9.31.6",
    "@wdio/mocha-framework": "^9.31.6",
    "@xmldom/xmldom": "^0.9.12",
    "appium": "^3.7.0",
    "appium-uiautomator2-driver": "^8.6.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "jest": "^30.5.1",
    "js-yaml": "^5.4.1",
    "mocha": "^12.0.0",
    "obsidian": "^1.13.1",
    "secretlint": "^13.0.5",
    "ts-jest": "^29.4.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "wdio-obsidian-reporter": "^3.2.0",
    "wdio-obsidian-service": "^3.2.0"
  },
  "dependencies": {
    "node-diff3": "^3.2.1",
    "reconcile-text": "^0.12.1"
  }
}
