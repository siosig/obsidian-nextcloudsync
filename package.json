{
  "name": "obsidian-nextcloudsync",
  "version": "1.0.14-beta.1",
  "description": "Bidirectional sync between Obsidian and Nextcloud",
  "main": "main.js",
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "lint": "eslint src",
    "secretlint": "secretlint \"**/*\"",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:b1": "jest --config jest.b1.config.js",
    "test:b2": "wdio run wdio.conf.mts",
    "test:b3": "wdio run wdio.android.conf.mts",
    "test:b4": "jest --config jest.b4.config.js --runInBand"
  },
  "keywords": [
    "obsidian",
    "nextcloud",
    "sync",
    "webdav"
  ],
  "author": "Daisuke ITO",
  "license": "MIT",
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@secretlint/secretlint-rule-pattern": "^13.0.7",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.7",
    "@types/jest": "^30.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.5",
    "@types/semver": "^7.8.0",
    "@wdio/appium-service": "^9.31.6",
    "@wdio/cli": "^9.31.6",
    "@wdio/local-runner": "^9.31.6",
    "@wdio/mocha-framework": "^9.31.6",
    "@xmldom/xmldom": "^0.9.12",
    "appium": "^3.8.0",
    "appium-uiautomator2-driver": "^8.7.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "jest": "^30.5.2",
    "mocha": "^12.0.3",
    "obsidian": "^1.14.4",
    "secretlint": "^13.0.7",
    "ts-jest": "^29.4.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "wdio-obsidian-reporter": "^3.3.0",
    "wdio-obsidian-service": "^3.3.0",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "node-diff3": "^3.2.1",
    "reconcile-text": "^0.13.2",
    "semver": "^7.8.5"
  }
}
